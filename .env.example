# Biotech Terminal Platform Configuration

# Application
APP_NAME="Biotech Terminal Platform"
DEBUG=false
API_VERSION=v1

# Server
HOST=0.0.0.0
PORT=8000

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:8080

# Database
DATABASE_URL=sqlite:///./biotech_terminal.db

# Redis (optional)
REDIS_URL=redis://localhost:6379

# External APIs (optional - platform works without them)
FDA_API_KEY=
CLINICALTRIALS_API_KEY=
PUBMED_API_KEY=
PUBMED_EMAIL=your-email@yourcompany.com

# Advanced Intelligence APIs (optional)
OPENFDA_API_KEY=
PROTEIN_DATA_BANK_API_KEY=
UNIPROT_API_KEY=

# Data Lake / Ingestion
DATA_LAKE_DIR=data/lake
PARQUET_DIR=data/lake/parquet
DUCKDB_PATH=data/lake/biotech.duckdb

# Evidence Graph Storage
# Options: "json" (legacy) or "sqlite" (recommended)
EVIDENCE_GRAPH_STORAGE=json
EVIDENCE_GRAPH_DB_URL=sqlite:///./data/evidence_graph.db

# Security
# IMPORTANT: Change SECRET_KEY in production!
SECRET_KEY=CHANGE-ME-IN-PRODUCTION-use-python-secrets-token-urlsafe-32
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Logging
# LOG_LEVEL: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# LOG_FORMAT: "json" (structured) or "text" (human-readable)
LOG_FORMAT=json

# Observability - Sentry
# Get your DSN from https://sentry.io/
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE: 0.0 to 1.0 (percentage of transactions to trace)
SENTRY_TRACES_SAMPLE_RATE=0.1

# Observability - Metrics
METRICS_ENABLED=true

# API Token Authentication
# Enable authentication for write operations (POST, PUT, DELETE, PATCH)
# GET requests remain public for read-only access
API_TOKEN_ENABLED=false
API_TOKEN=

# Example production configuration:
# API_TOKEN_ENABLED=true
# API_TOKEN=your-secure-random-token-here-change-me

#############################################
# ENTERPRISE INTEGRATION
#############################################
# Bloomberg Terminal Integration
BLOOMBERG_ENABLED=false
BLOOMBERG_API_HOST=
BLOOMBERG_API_PORT=
BLOOMBERG_API_KEY=

# AlphaSense Integration
ALPHASENSE_ENABLED=false
ALPHASENSE_API_KEY=
ALPHASENSE_API_URL=https://api.alpha-sense.com

# Proxy Settings (for corporate networks)
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1

#############################################
# DEPLOYMENT SETTINGS
#############################################
# Options: development, staging, production
DEPLOYMENT_MODE=development

# Uvicorn workers (for production)
WORKERS=4

# Database connection pool
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Request timeout (seconds)
REQUEST_TIMEOUT=30
