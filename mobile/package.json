{
  "name": "biotech-terminal-mobile",
  "version": "1.0.0",
  "description": "Biotech Terminal Mobile - iOS-style pharmaceutical intelligence mobile app",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite --port 3002",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "cap:init": "cap init",
    "cap:add:ios": "cap add ios",
    "cap:sync": "cap sync",
    "cap:sync:ios": "cap sync ios",
    "cap:open:ios": "cap open ios",
    "cap:build": "npm run build && cap sync",
    "cap:run:ios": "cap run ios"
  },
  "dependencies": {
    "@biotech-terminal/frontend-components": "file:../frontend-components",
    "@capacitor/cli": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/haptics": "^7.0.2",
    "@capacitor/ios": "^7.4.3",
    "@capacitor/keyboard": "^7.0.3",
    "@capacitor/local-notifications": "^7.0.3",
    "@capacitor/push-notifications": "^7.0.3",
    "@capacitor/share": "^7.0.2",
    "@capacitor/status-bar": "^7.0.3",
    "@tanstack/react-query": "^5.12.2",
    "axios": "^1.6.2",
    "date-fns": "^2.30.0",
    "framer-motion": "^11.11.17",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^6.20.1",
    "recharts": "^3.2.1",
    "victory-native": "^41.20.1",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
